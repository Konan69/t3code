{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "cloudbox:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "T3CODE_CLERK_JWT_TEMPLATE": "t3-relay",
        "T3CODE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudDMuY29kZXMk",
        "T3CODE_IOS_PERSONAL_TEAM": "1",
        "T3CODE_IOS_PERSONAL_TEAM_BUNDLE_ID": "com.myproxi.t3code.dev",
        "T3CODE_RELAY_URL": "https://relay.t3.codes"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "cloudbox:testflight": {
      "extends": "cloudbox:dev",
      "autoIncrement": true,
      "developmentClient": false,
      "distribution": "store"
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "cloudbox:testflight": {},
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
